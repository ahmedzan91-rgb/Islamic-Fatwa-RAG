# ═══════════════════════════════════════════════
#  الأسرار — لا تُرفع أبداً
# ═══════════════════════════════════════════════
.streamlit/secrets.toml
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# ═══════════════════════════════════════════════
#  البيانات والمخرجات (ثقيلة / خاصة)
# ═══════════════════════════════════════════════
data/*.csv
data/*.tsv
data/*.json
data/*.xlsx
!data/.gitkeep

# ── بيانات الفتاوى المضغوطة (مسموح برفعها) ──
# الخام كبير جداً على GitHub (139 ألف فتوى ≈ 300 MB > حدّ 100 MB)،
# لكن المضغوط ≈ 50 MB يمرّ بنجاح — والنظام يقرأ .gz مباشرة بلا فكّ.
# جهّزها بالأداة:  python prepare_data_for_github.py --compress --split
!data/*.csv.gz
!data/*.tsv.gz

artifacts/*
!artifacts/.gitkeep

# سجلّ الملفات المرفوعة من الواجهة (خاص بكل بيئة)
data/_uploads_registry.json

chroma_db/*
!chroma_db/.gitkeep

*.parquet
*.sqlite3
*.duckdb

# ═══════════════════════════════════════════════
#  بايثون
# ═══════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

.venv/
venv/
ENV/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ═══════════════════════════════════════════════
#  نماذج ومخابئ Hugging Face
# ═══════════════════════════════════════════════
.cache/
models/
*.bin
*.safetensors

# ═══════════════════════════════════════════════
#  نظام التشغيل والمحرّرات
# ═══════════════════════════════════════════════
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
